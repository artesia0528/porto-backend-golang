# Environment Configuration
# Copy this file to .env and fill in the values

# ---- App ----
PORT=8080
JWT_SECRET=ganti_dengan_string_rahasia_yang_panjang_dan_acak
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://krisnaaditya.my.id,https://www.krisnaaditya.my.id

# ---- Database (digunakan saat `go run` langsung) ----
DATABASE_URL=host=localhost user=postgres password=postgres dbname=portfolio port=5432 sslmode=disable

# ---- Docker Production (digunakan oleh docker-compose.prod.yml) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio
